# ─── omen-clinic-agent environment ──────────────────────────────────────────
# EVERY variable below is OPTIONAL. With none set, the agent runs fully offline
# in "mock mode": a deterministic, rule-based LLM and no outbound network calls.
# Copy this file to `.env` only when you want to wire up real WhatsApp / Claude.

# HTTP port for the Express server (default 3000)
PORT=3000

# ── Meta WhatsApp Cloud API (outbound sending) ──────────────────────────────
# Permanent access token from the Meta app. Leave blank for the offline demo;
# replies are printed to the console instead of being sent.
WHATSAPP_TOKEN=

# The verify token YOU invent. Must match what you type into the Meta webhook
# configuration screen. Used by GET /webhook to answer Meta's challenge.
WHATSAPP_VERIFY_TOKEN=omen-verify-dev

# The Cloud API phone_number_id. This is how an inbound message is mapped to a
# tenant/clinic (see data/clinics.json -> whatsapp.phoneNumberId).
WHATSAPP_PHONE_NUMBER_ID=1000000001

# App Secret from the Meta app. When set, POST /webhook enforces the
# X-Hub-Signature-256 HMAC check on every inbound payload. Blank = not enforced.
WHATSAPP_APP_SECRET=

# ── Dashboard auth + API (Phase 1, Slice C) ─────────────────────────────────
# APP_SECRET signs the dashboard session cookies (HMAC). DISTINCT from
# WHATSAPP_APP_SECRET above. A dev default is used if unset (offline demo/tests);
# ALWAYS set a strong random value in production. Generate one with:
#   openssl rand -hex 48      (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
APP_SECRET=
# Optional: force the Secure cookie flag on/off (default: on when NODE_ENV=production).
# COOKIE_SECURE=1
# Optional overrides (ms): sliding session lifetime and SSE heartbeat cadence.
# SESSION_TTL_MS=604800000
# SSE_HEARTBEAT_MS=25000

# ── LLM providers (OPTIONAL upgrade — selection: Gemini → Anthropic → mock) ─
# Free-form replies (fallback / smalltalk / FAQ rephrasing) can be generated by
# a real LLM via global fetch (no SDK). The deterministic booking engine is
# identical either way, so the demo never depends on these keys. On ANY provider
# error the reply degrades to the deterministic mock — conversations never break.

# Google Gemini (checked FIRST — wins even if ANTHROPIC_API_KEY is also set,
# e.g. a machine-global key pointing at a non-Anthropic gateway). The key is
# sent in the x-goog-api-key header, never in the URL.
GEMINI_API_KEY=
# Use a rolling alias (…-latest): pinned dated models get retired and return 404
# "no longer available to new users", which silently degrades every reply to the
# deterministic mock. gemini-flash-latest is the current fast receptionist model.
GEMINI_MODEL=gemini-flash-latest
# Per-request timeout in ms before falling back to the deterministic reply.
# GEMINI_TIMEOUT_MS=8000

# Anthropic Claude (used only when GEMINI_API_KEY is absent).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Conversation mode (P2-HUMANIZE) ─────────────────────────────────────────
# llm     = LLM-led dialogue: Gemini plans each turn (structured output), a
#           deterministic executor owns every write (datetimes, bookings,
#           guardrails). Falls back to classic automatically on any LLM
#           timeout (GEMINI_TIMEOUT_MS) or error — the bot never goes silent.
# classic = the scripted state-machine flow (always used by `npm run simulate`
#           and whenever no Gemini key is available).
# Default: llm when GEMINI_API_KEY is set, classic otherwise.
# CONVERSATION_MODE=llm

# ── Inbound media (P2-D) ────────────────────────────────────────────────────
# Patient X-rays/documents/voice notes are downloaded from the Graph API and
# stored on disk (data/media by default), served only through the auth-gated
# GET /api/media/:id route. Purge old files with:  npm run media:purge  (cron).
# MEDIA_DIR=
# MEDIA_MAX_BYTES=10485760
# MEDIA_RETENTION_DAYS=90

# ── Storage (Phase 1) ───────────────────────────────────────────────────────
# Zero-config default is the JSON file store (offline, single PM2 instance).
# Set DATABASE_URL to use Postgres, then:  npm run db:migrate  &&  npm run db:seed
# STORE can force the adapter explicitly (json | postgres); normally leave blank.
# DATABASE_URL=postgres://omen:secret@127.0.0.1:5432/omen
# STORE=
# PGPOOL_MAX=10
