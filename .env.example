# ─── omen-clinic-agent environment ──────────────────────────────────────────
# EVERY variable below is OPTIONAL. With none set, the agent runs fully offline
# in "mock mode": a deterministic, rule-based LLM and no outbound network calls.
# Copy this file to `.env` only when you want to wire up real WhatsApp / Claude.

# HTTP port for the Express server (default 3000)
PORT=3000

# ── Meta WhatsApp Cloud API (outbound sending) ──────────────────────────────
# Permanent access token from the Meta app. Leave blank for the offline demo;
# replies are printed to the console instead of being sent.
WHATSAPP_TOKEN=

# The verify token YOU invent. Must match what you type into the Meta webhook
# configuration screen. Used by GET /webhook to answer Meta's challenge.
WHATSAPP_VERIFY_TOKEN=omen-verify-dev

# The Cloud API phone_number_id. This is how an inbound message is mapped to a
# tenant/clinic (see data/clinics.json -> whatsapp.phoneNumberId).
WHATSAPP_PHONE_NUMBER_ID=1000000001

# App Secret from the Meta app. When set, POST /webhook enforces the
# X-Hub-Signature-256 HMAC check on every inbound payload. Blank = not enforced.
WHATSAPP_APP_SECRET=

# ── Anthropic (OPTIONAL LLM upgrade) ────────────────────────────────────────
# If ANTHROPIC_API_KEY is present, free-form replies (fallback / smalltalk) are
# generated by Claude via global fetch (no SDK). The deterministic booking
# engine is identical either way, so the demo never depends on this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Storage (Phase 1) ───────────────────────────────────────────────────────
# Zero-config default is the JSON file store (offline, single PM2 instance).
# Set DATABASE_URL to use Postgres, then:  npm run db:migrate  &&  npm run db:seed
# STORE can force the adapter explicitly (json | postgres); normally leave blank.
# DATABASE_URL=postgres://omen:secret@127.0.0.1:5432/omen
# STORE=
# PGPOOL_MAX=10
