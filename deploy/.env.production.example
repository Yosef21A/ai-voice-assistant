# ═══════════════════════════════════════════════════════════════════════════
#  omen-clinic-agent — PRODUCTION .env
#  Copy to the app root as `.env` (NOT into deploy/):  cp deploy/.env.production.example .env
#  Then: chmod 600 .env   (it is git-ignored; it holds live secrets)
#
#  Loaded by src/config.js. Real process.env wins over this file, so PM2's
#  env_production (NODE_ENV, PORT) overrides anything set here with the same name.
#  Every value below maps 1:1 to a field read in src/config.js — no extras.
# ═══════════════════════════════════════════════════════════════════════════

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Port the Express server binds. Must match the Nginx upstream (127.0.0.1:3000)
# and PM2 env_production.PORT. Keep it bound to localhost via Nginx; never expose
# 3000 to the internet (ufw allows only 22/80/443 — see RUNBOOK §A).
PORT=3000

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Permanent System-User access token.
#   Meta Business Settings -> Users -> System users -> (your system user)
#   -> Generate new token -> select the App -> scopes:
#        whatsapp_business_messaging   (send/receive)
#        whatsapp_business_management  (manage numbers/templates)
#   Choose "Never" expiry. Copy it ONCE — it is not shown again.
# One token can serve every clinic if the System User has access to each WABA's
# phone number (multi-tenant; see RUNBOOK §G). Leave BLANK to run in mock mode
# (replies are logged to the console, nothing is sent).
WHATSAPP_TOKEN=

# The verify token YOU invent. It must be byte-identical to the "Verify token"
# you type into the Meta webhook config screen (App -> WhatsApp -> Configuration).
# Generate a strong one:   openssl rand -hex 24
# Do NOT ship the dev default ("omen-verify-dev") to production.
WHATSAPP_VERIFY_TOKEN=

# Default tenant's Cloud API phone_number_id, used only when an inbound payload
# has no metadata (e.g. manual /simulate calls). Real inbound WhatsApp messages
# are routed per-message by the phone_number_id in the webhook, matched against
# data/clinics.json -> whatsapp.phoneNumberId. Find it at:
#   App -> WhatsApp -> API Setup -> "Phone number ID" (NOT the display number).
# Seed value for El Amen (Sousse) in the shipped clinics.json is 1000000001;
# replace with the real production phone_number_id.
WHATSAPP_PHONE_NUMBER_ID=

# App Secret — REQUIRED in production. When set, POST /webhook enforces the
# X-Hub-Signature-256 HMAC on every inbound payload (server.js verifySignature).
# Blank = signature check disabled (dev only). Get it at:
#   App -> App settings -> Basic -> App secret -> "Show".
WHATSAPP_APP_SECRET=

# ── Dashboard auth + API (Phase 1, Slice C) ──────────────────────────────────
# APP_SECRET signs the dashboard login session cookies (HMAC-SHA256). This is a
# DIFFERENT secret from WHATSAPP_APP_SECRET above. REQUIRED in production — if it
# leaks or changes, all existing sessions are invalidated. Generate a strong one:
#   openssl rand -hex 48
# (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
APP_SECRET=
# Cookies are marked Secure automatically when NODE_ENV=production (PM2 sets it).
# Override only if you terminate TLS oddly: COOKIE_SECURE=1|0
# COOKIE_SECURE=1
# Optional (ms): sliding session lifetime (default 7d) and SSE heartbeat cadence.
# SESSION_TTL_MS=604800000
# SSE_HEARTBEAT_MS=25000

# ── Anthropic (OPTIONAL LLM upgrade) ─────────────────────────────────────────
# OPTIONAL. Booking is fully deterministic in the engine either way; this only
# upgrades free-form/fallback phrasing to Claude. Leave BLANK to stay on the
# zero-cost mock provider. If set, use a scoped key from console.anthropic.com.
ANTHROPIC_API_KEY=

# Model used only when ANTHROPIC_API_KEY is set. Default is fine (cheap, fast).
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Inbound media (P2-D) ─────────────────────────────────────────────────────
# Patient X-rays/documents/voice notes downloaded from Graph, stored on disk,
# served ONLY via the auth-gated GET /api/media/:id route (data/ is never
# static). Add the retention cron next to the digests (RUNBOOK §F7):
#   15 3 * * *  cd /opt/omen-clinic-agent && npm run --silent media:purge >> logs/purge.log 2>&1
# MEDIA_DIR=                    # default: <app>/data/media
# MEDIA_MAX_BYTES=10485760      # 10MB product cap per file
# MEDIA_RETENTION_DAYS=90       # purge window (patient-data guardrail)

# ── Storage / Postgres (Phase 1) ─────────────────────────────────────────────
# Youssef runs PG16. Provision a database + role, set DATABASE_URL below, then:
#   npm run db:migrate    # apply sql/*.sql (tracked in schema_migrations)
#   npm run db:seed       # import data/clinics.json into the tenants table
# Leave DATABASE_URL BLANK to keep the zero-config JSON store (SINGLE PM2
# instance only — see RUNBOOK). Once the API layer (P1-C) consumes Postgres,
# that single-instance constraint lifts.
#   Format: postgres://USER:PASSWORD@HOST:5432/DBNAME  (add ?sslmode=require if TLS)
DATABASE_URL=
# STORE=          # optional: json | postgres (defaults from DATABASE_URL presence)
# PGPOOL_MAX=10   # optional: max pooled connections (default 10)
