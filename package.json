{
  "name": "omen-clinic-agent",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI agent for medical-tourism clinics in Tunisia (Sousse/Sfax). Multi-tenant, conversational in Arabic / French / English. Runs fully offline in mock mode.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "simulate": "node src/simulate.js",
    "test": "node --test",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js"
  },
  "keywords": [
    "whatsapp",
    "medical-tourism",
    "clinic",
    "chatbot",
    "tunisia",
    "multilingual"
  ],
  "author": "OmenLabz",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.19.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.1.5"
  }
}
